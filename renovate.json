{
  "extends": [
    "config:base"
  ],
  "groupName": "all",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "The docs Gemfile pins jekyll ~> 3.10; disable major updates",
      "matchPackageNames": [
        "jekyll"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "github-pages (Jekyll 3.9 / activesupport 6) cannot use tzinfo 2 or bulma-clean-theme 1",
      "matchPackageNames": [
        "tzinfo",
        "bulma-clean-theme"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "github-pages 232 pins jekyll-feed = 0.17.0",
      "matchPackageNames": [
        "jekyll-feed"
      ],
      "enabled": false
    },
    {
      "description": "Automerge GitHub Actions updates (including majors)",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": true
    },
    {
      "description": "Keep docker/image majors out of grouped update-all PRs and do not automerge them",
      "matchDatasources": [
        "docker"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "docker major",
      "automerge": false
    }
  ],
  "platformAutomerge": true
}
